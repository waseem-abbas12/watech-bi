# =====================================================================
# WATECH-BI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production or enter in Vercel Project Settings > Environment Variables
# NEVER commit real production secrets into Git!
# =====================================================================

# 1. APPLICATION URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# 2. DATABASE (PostgreSQL / Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://user:password@host:5432/watech_bi?sslmode=require&pgbouncer=true"

# 3. AUTHENTICATION & SECURITY (Min 32 characters random string)
JWT_SECRET="generate-a-secure-random-32-byte-hex-string-for-production"
ENCRYPTION_SECRET="generate-a-secure-random-32-byte-encryption-secret-for-credentials-at-rest"
WEBHOOK_INBOUND_SECRET="generate-secure-webhook-hmac-sha256-secret"
STORAGE_SIGNING_SECRET="generate-another-secure-random-secret-for-file-urls"

# 4. BACKGROUND JOBS & CRON (Vercel Cron Bearer Token)
CRON_SECRET="generate-secure-cron-bearer-token"

# 5. TRANSACTIONAL EMAIL (Resend.com or SMTP)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Watech Intelligence <no-reply@your-agency.com>"

# 6. SUBSCRIPTION BILLING (Stripe)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# 7. AI ENGINE (Optional External AI Provider)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# 8. EXTERNAL BUSINESS DISCOVERY (Google Places API / Google Maps Platform)
# Required for autonomous business discovery: Google Places API (New) Text Search
# Get key at: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=""
